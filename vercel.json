{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "nextjs"
    },
    "server": {
      "root": "server",
      "framework": "nestjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
